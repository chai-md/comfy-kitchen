+def _mod_scale_shift(h, shift, scale, segments):
+    # segments: [(start, stop, mod_row)] tiling h's rows; mod_row is an index or a
+    # per-token index tensor.
+    #
+    # torch does two read-modify-write passes over the bf16 matrix, which runs at
+    # 115-150 GB/s on GB10 (write-allocate). comfy-kitchen's Triton kernel does the
+    # same arithmetic in one out-of-place pass at ~222 GB/s: 8092us -> 2721us at
+    # M=27280/K=5376, bit-identical (the kernel re-imposes both bf16 roundings with
+    # integer math, because Triton would otherwise contract mul+add into one FMA).
+    #
+    # Two things the kernel needs and torch does not: a contiguous activation, and
+    # modulation tensors it can index as row * cols (it materialises strided views
+    # itself). Anything else raises, and we fall back here — the fallback is loud
+    # once so a regression cannot hide behind a silent 2x slowdown.
+    if (
+        _ck_scale_shift is not None
+        and h.dtype in (torch.bfloat16, torch.float16)
+        and h.shape[1] >= 256
+    ):
+        try:
+            row_mod = _ck_row_mod(h.shape[0], segments, h.device)
+            return _ck_scale_shift(h, scale, shift, row_mod)
+        except Exception as exc:
+            global _ck_scale_shift_warned
+            if not _ck_scale_shift_warned:
+                print(f"comfy-kitchen fused modulation disabled: {exc!r}", file=sys.stderr)
+                _ck_scale_shift_warned = True
+    return _mod_scale_shift_ref(h, shift, scale, segments)
